{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://analiticas.alexalvarez.dev https://js.stripe.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https://res.cloudinary.com https://*.amazonaws.com; font-src 'self' data:; connect-src 'self' https://otp-web-back.vercel.app https://*.auth0.com https://analiticas.alexalvarez.dev https://api.stripe.com https://api.cloudinary.com https://res.cloudinary.com https://*.amazonaws.com; frame-src https://open.spotify.com https://www.youtube.com https://www.youtube-nocookie.com https://maps.google.com https://www.google.com https://js.stripe.com https://*.auth0.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/(spa|404)(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/estudios",
      "destination": "/estudio",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-:type.xml",
      "destination": "/api/sitemap?type=:type"
    },
    {
      "source": "/revista/rss.xml",
      "destination": "/api/rss"
    },
    {
      "source": "/artistas/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|google-inspectiontool|storebot-google|google-extended|bingbot|adidxbot|applebot|duckduckbot|yandex|baiduspider|slurp|gptbot|oai-searchbot|chatgpt-user|claudebot|claude-web|perplexitybot|amazonbot|bytespider).*"
        }
      ],
      "destination": "/api/og?type=artists&id=:id&mode=index"
    },
    {
      "source": "/eventos/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|google-inspectiontool|storebot-google|google-extended|bingbot|adidxbot|applebot|duckduckbot|yandex|baiduspider|slurp|gptbot|oai-searchbot|chatgpt-user|claudebot|claude-web|perplexitybot|amazonbot|bytespider).*"
        }
