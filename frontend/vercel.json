{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://analiticas.alexalvarez.dev https://js.stripe.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https://res.cloudinary.com https://*.amazonaws.com; font-src 'self' data:; connect-src 'self' https://otp-web-back.vercel.app https://*.auth0.com https://analiticas.alexalvarez.dev https://api.stripe.com https://api.cloudinary.com https://res.cloudinary.com https://*.amazonaws.com; frame-src https://open.spotify.com https://www.youtube.com https://www.youtube-nocookie.com https://maps.google.com https://www.google.com https://js.stripe.com https://*.auth0.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-:type.xml",
      "destination": "/api/sitemap?type=:type"
    },
    {
      "source": "/artistas/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|google-inspectiontool|storebot-google|google-extended|bingbot|adidxbot|applebot|duckduckbot|yandex|baiduspider|slurp|gptbot|oai-searchbot|chatgpt-user|claudebot|claude-web|perplexitybot|amazonbot|bytespider).*"
        }
      ],
      "destination": "/api/og?type=artists&id=:id&mode=index"
    },
    {
      "source": "/eventos/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|google-inspectiontool|storebot-google|google-extended|bingbot|adidxbot|applebot|duckduckbot|yandex|baiduspider|slurp|gptbot|oai-searchbot|chatgpt-user|claudebot|claude-web|perplexitybot|amazonbot|bytespider).*"
        }
      ],
      "destination": "/api/og?type=events&id=:id&mode=index"
    },
    {
      "source": "/beats/:id((?!(?:trap|hoodtrap|reggaeton|jerk|drill)$)[^/]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|google-inspectiontool|storebot-google|google-extended|bingbot|adidxbot|applebot|duckduckbot|yandex|baiduspider|slurp|gptbot|oai-searchbot|chatgpt-user|claudebot|claude-web|perplexitybot|amazonbot|bytespider).*"
        }
      ],
      "destination": "/api/og?type=beats&id=:id&mode=index"
    },
    {
      "source": "/discografia/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|google-inspectiontool|storebot-google|google-extended|bingbot|adidxbot|applebot|duckduckbot|yandex|baiduspider|slurp|gptbot|oai-searchbot|chatgpt-user|claudebot|claude-web|perplexitybot|amazonbot|bytespider).*"
        }
      ],
      "destination": "/api/og?type=releases&id=:id&mode=index"
    },
    {
      "source": "/artistas/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawl|spider|facebookexternalhit|WhatsApp|Telegram|Twitterbot|Slackbot|Discordbot|LinkedInBot|Pinterest|Embedly|Quora|Outbrain|vkShare|Redditbot).*"
        }
      ],
      "destination": "/api/og?type=artists&id=:id&mode=social"
    },
    {
      "source": "/eventos/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawl|spider|facebookexternalhit|WhatsApp|Telegram|Twitterbot|Slackbot|Discordbot|LinkedInBot|Pinterest|Embedly|Quora|Outbrain|vkShare|Redditbot).*"
        }
      ],
      "destination": "/api/og?type=events&id=:id&mode=social"
    },
    {
      "source": "/beats/:id((?!(?:trap|hoodtrap|reggaeton|jerk|drill)$)[^/]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawl|spider|facebookexternalhit|WhatsApp|Telegram|Twitterbot|Slackbot|Discordbot|LinkedInBot|Pinterest|Embedly|Quora|Outbrain|vkShare|Redditbot).*"
        }
      ],
      "destination": "/api/og?type=beats&id=:id&mode=social"
    },
    {
      "source": "/discografia/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawl|spider|facebookexternalhit|WhatsApp|Telegram|Twitterbot|Slackbot|Discordbot|LinkedInBot|Pinterest|Embedly|Quora|Outbrain|vkShare|Redditbot).*"
        }
      ],
      "destination": "/api/og?type=releases&id=:id&mode=social"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/:page(artistas|eventos|beats|discografia|discografica-barcelona|booking-artistas|estudios|contacto|herramientas|plugins|newsletters|privacidad|terminos|cookies|ruralmafia|crear|scanner|perfil|unsubscribe)",
      "destination": "/index.html"
    },
    {
      "source": "/:section(artistas|eventos|beats|discografia|news|ticket|l)/:id",
      "destination": "/index.html"
    },
    {
      "source": "/plugins/opr-w1",
      "destination": "/index.html"
    },
    {
      "source": "/admin/newsletter",
      "destination": "/index.html"
    }
  ]
}
